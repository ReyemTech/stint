---
// ASCII-styled mock of the menu-bar popover. CSS in src/styles/custom.css
// under .popover-mock and friends.
---

<div class="popover-mock">
  <div class="popover-header">
    <span class="popover-eyebrow">TRACKING</span>
    <span class="popover-live"><span class="live-dot"></span> Live</span>
  </div>
  <div class="popover-time">01:12:04</div>
  <div class="popover-desc">fixing the queue bug</div>
  <div class="popover-stop">Stop timer</div>
  <div class="popover-footer">
    <span>Open Stint →</span>
    <span>⚙</span>
    <span>Solidtime ↗</span>
  </div>
</div>
