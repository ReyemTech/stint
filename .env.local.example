# Build-time secrets for stint dev builds.
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit secrets.
#
# scripts/dev-app.sh (and scripts/dev-cli.sh) source `.env.local` if
# present so option_env! in stint-core picks up these values at
# compile time. A build.rs directive (rerun-if-env-changed) ensures
# changing a value triggers a recompile.

# Google Cloud OAuth client for Desktop apps. Required for
# Settings → Calendar → Add Google account. Without these, the
# Google flow short-circuits with "not configured".
#
# Provision at https://console.cloud.google.com/ → APIs & Services
# → Credentials → OAuth 2.0 Client → Desktop application.
export STINT_GOOGLE_CLIENT_ID=""
export STINT_GOOGLE_CLIENT_SECRET=""
